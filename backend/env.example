JWT_EXPIRES_IN=7d

# Setu API Configuration - Sandbox Environment
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=b615a43a-e779-4d95-9ddb-768c7666d96b
SETU_CLIENT_SECRET=eY6l9Wbdm488SdS3lbeznFwDLtsbVvQM
